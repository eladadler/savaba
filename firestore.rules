rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isMatchmaker() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'mm';
    }

    function isAdminOrMm() {
      return isAdmin() || isMatchmaker();
    }

    // ── users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── candidates ─────────────────────────────────────────
    match /candidates/{candId} {
      allow read: if isSignedIn();
      // Matchmakers/admins create candidates (mm_fills flow)
      // Candidates create their own profile (cand_fills flow)
      allow create: if isSignedIn() && (
        isAdminOrMm() ||
        request.resource.data.get('candidateUid', '') == request.auth.uid
      );
      allow update: if isAdminOrMm();
      allow delete: if isAdmin();
    }

    // ── invitations ────────────────────────────────────────
    match /invitations/{token} {
      // Unauth read needed for invite landing page (user not yet logged in)
      allow read: if true;
      allow create: if isAdminOrMm();
      // Candidates update the invitation when they fill their profile
      // The token itself is the secret; possession = authorization
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.get('toUid', '') == request.auth.uid
      );
      // Both candidates (after filling profile) and matchmakers send notifications
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.get('toUid', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── offers ─────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrMm();
      allow delete: if isAdmin();
    }

    // ── config ─────────────────────────────────────────────
    match /config/{doc} {
      // Public read: invite landing needs texts; unauthed candidates need settings
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── ai_learnings ────────────────────────────────────────
    match /ai_learnings/{doc} {
      allow read, write: if isAdminOrMm();
    }

    // ── ai_pair_cache ───────────────────────────────────────
    match /ai_pair_cache/{doc} {
      allow read, write: if isAdminOrMm();
    }

    // ── ai_pair_feedback ────────────────────────────────────
    match /ai_pair_feedback/{doc} {
      allow read, write: if isAdminOrMm();
    }

    // ── mm_chats ────────────────────────────────────────────
    match /mm_chats/{doc} {
      allow read, write: if isAdminOrMm();
    }

    // ── engagements ─────────────────────────────────────────
    match /engagements/{doc} {
      allow read, write: if isAdminOrMm();
    }

    // ── coRepRequests ────────────────────────────────────────
    match /coRepRequests/{doc} {
      allow read, write: if isAdminOrMm();
    }

    // ── deletions ────────────────────────────────────────────
    match /deletions/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
